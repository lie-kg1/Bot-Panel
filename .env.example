# Copy this file to .env and fill in real values before starting the panel.

# Password required to log into the panel
PANEL_PASSWORD=change-me

# Random long string used to sign the session cookie
SESSION_SECRET=change-this-to-a-random-string

# Port the panel web server listens on
PORT=3000

# Command used to launch the bot process
BOT_COMMAND=python3
BOT_ARGS=bot.py

# Working directory the bot process runs from (relative to this project, or absolute)
BOT_CWD=./bot
