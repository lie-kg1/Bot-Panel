# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Set true only if the panel sits behind HTTPS (e.g. behind Caddy/nginx)
COOKIE_SECURE=false
# Set true only if also behind a reverse proxy, so req.ip resolves correctly
TRUST_PROXY=false

# Bot process this panel controls
BOT_COMMAND=python3
BOT_ARGS=bot.py
BOT_CWD=./bot

# Folder where uploaded music files are stored
MUSIC_DIR=./music

# First-run owner account bootstrap.
# If left unset, the panel creates username "owner" with password
# "change-me-immediately" on first start and prints a warning - set these
# so that doesn't happen, or change the password immediately after first login.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-immediately
OWNER_EMAIL=
